    "er_client_name": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "$ref": "#/$defs/EarthRangerConnection",
          "title": "",
          "description": "Select one of your configured data sources."
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "Connect to EarthRanger"
    },
    "gee_project_name": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "$ref": "#/$defs/GoogleEarthEngineConnection",
          "title": "",
          "description": "Select one of your configured data sources."
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "Connect to EarthEngine"
    },
    "Subject Group": {
      "type": "object",
      "description": "Choose subject group to analyze",
      "ecoscope:task_group": true,
      "properties": {
        "subject_group_var": {
          "additionalProperties": false,
          "properties": {
            "var": {
              "title": "Subject Group Name",
              "type": "string",
              "default": "Elephants"
            }
          },
          "required": [
            "var"
          ],
          "type": "object",
          "title": ""
        }
      }
    },
    "custom_trajs_filter": {
      "additionalProperties": false,
      "properties": {
        "min_length_meters": {
          "default": 0.001,
          "title": "Min Length Meters",
          "type": "number",
          "description": "Minimum segment length in meters.",
          "ecoscope:advanced": true
        },
        "max_length_meters": {
          "default": 5000,
          "title": "Max Length Meters",
          "type": "number",
          "description": "Maximum segment length in meters.",
          "ecoscope:advanced": true
        },
        "min_time_secs": {
          "default": 1,
          "title": "Min Time Secs",
          "type": "number",
          "description": "Minimum segment duration in seconds.",
          "ecoscope:advanced": true
        },
        "max_time_secs": {
          "default": 21600,
          "title": "Max Time Secs",
          "type": "number",
          "description": "Maximum segment duration in seconds.",
          "ecoscope:advanced": true
        },
        "min_speed_kmhr": {
          "default": 0.01,
          "title": "Min Speed Kmhr",
          "type": "number",
          "description": "Minimum segment speed in km/h.",
          "ecoscope:advanced": true
