{
  "properties": {
    "workflow_details": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Workflow Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Workflow Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "description": "Add information that will help to differentiate this workflow from another.",
      "title": "Set workflow details"
    },
    "time_range": {
      "additionalProperties": false,
      "properties": {
        "since": {
          "format": "date-time",
          "title": "Since",
          "type": "string",
          "description": "The start time"
        },
        "until": {
          "format": "date-time",
          "title": "Until",
          "type": "string",
          "description": "The end time"
        },
        "timezone": {
          "allOf": [
            {
              "$ref": "#/$defs/TimezoneInfo"
            }
          ],
          "default": null,
          "title": "Timezone"
        },
        "time_format": {
          "default": "%d %b %Y %H:%M:%S",
          "title": "Time Format",
          "type": "string",
          "description": "The time format",
          "ecoscope:advanced": true
        }
      },
      "required": [
        "since",
        "until"
      ],
      "type": "object",
      "description": "Choose the period of time to analyze.",
      "title": "Define analysis time range"
    },
    "er_client_name": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "$ref": "#/$defs/EarthRangerConnection",
          "title": "",
          "description": "Select one of your configured data sources."
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "Connect to earth ranger"
    },
    "Subject Group": {
      "type": "object",
      "description": "Choose subject group to generate collar voltage charts and overall speedmap",
      "ecoscope:task_group": true,
      "properties": {
        "subject_group_var": {
          "additionalProperties": false,
          "properties": {
            "var": {
              "title": "Subject Group Name",
              "type": "string",
              "default": "Elephants"
            }
          },
          "required": [
            "var"
          ],
          "type": "object",
          "title": ""
        }
      }
    },
    "Previous Period": {
      "type": "object",
      "description": "Define the comparison (\"previous\") period to contrast against your selected time range. Every option below computes a period that ends on the same End Date as your time range, then works backward to determine its Start Date. Choose Custom to enter your own Years / Months / Weeks / Days offset (defaults to 1 month back), Preset for a common lookback (e.g. 1, 3 or 6 months, or 1 year back), or Calendar to pick an exact Start Date.",
      "ecoscope:task_group": true,
      "properties": {
        "set_previous_period": {
          "additionalProperties": false,
          "properties": {
            "offset": {
              "anyOf": [
                {
                  "$ref": "#/$defs/PresetPreviousPeriod"
                },
                {
                  "$ref": "#/$defs/CustomPreviousPeriod"
                },
                {
                  "$ref": "#/$defs/CalendarPreviousPeriod"
                }
              ],
              "title": "Offset",
              "description": "Choose how to calculate the comparison period's Start Date. In every mode, the comparison period ends on your selected time range's Start Date (so it never overlaps with the current period) \u2014 only the Start Date changes."
            }
          },
          "required": [
            "offset"
          ],
          "type": "object",
          "title": ""
        }
      }
    },
    "generate_word_report": {
      "additionalProperties": false,
      "properties": {
        "org_logo_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Org Logo Path"
        }
      },
      "required": [
        "org_logo_path"
      ],
      "type": "object",
      "title": "Generate Collar Voltage Word Report"
    }
  },
  "$defs": {
    "TimezoneInfo": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tzCode": {
          "title": "Tzcode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "utc": {
          "title": "Utc",
          "type": "string"
        }
      },
      "required": [
        "label",
        "tzCode",
        "name",
        "utc"
      ],
      "title": "TimezoneInfo",
      "type": "object"
    },
    "EarthRangerConnection": {
      "properties": {
        "name": {
          "title": "Data Source",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "EarthRangerConnection",
      "type": "object"
    },
    "CalendarPreviousPeriod": {
      "properties": {
        "since": {
          "description": "Select the start date for the comparison period.",
          "format": "date-time",
          "title": "Since",
          "type": "string"
        }
      },
      "required": [
        "since"
      ],
      "title": "Calendar",
      "type": "object"
    },
    "CustomPreviousPeriod": {
      "properties": {
        "years": {
          "default": 0,
          "title": "Years",
          "type": "integer"
        },
        "months": {
          "default": 0,
          "title": "Months",
          "type": "integer"
        },
        "weeks": {
          "default": 0,
          "title": "Weeks",
          "type": "integer"
        },
        "days": {
          "default": 0,
          "title": "Days",
          "type": "integer"
        },
        "hours": {
          "default": 0,
          "title": "Hours",
          "type": "integer"
        },
        "minutes": {
          "default": 0,
          "title": "Minutes",
          "type": "integer"
        },
        "seconds": {
          "default": 0,
          "title": "Seconds",
          "type": "integer"
        }
      },
      "title": "Custom",
      "type": "object"
    },
    "PresetPreviousPeriod": {
      "properties": {
        "preset": {
          "default": "1 month back",
          "description": "Choose a predefined time offset.",
          "enum": [
            "Same as current period",
            "1 month back",
            "3 months back",
            "6 months back",
            "1 year back"
          ],
          "title": "Preset",
          "type": "string"
        }
      },
      "title": "Preset",
      "type": "object"
    },
    "ValueGrouper": {
      "properties": {
        "index_name": {
          "oneOf": [
            {
              "const": "subject_name",
              "title": "Subject Name"
            }
          ]
        }
      }
    }
  },
  "uiSchema": {
    "workflow_details": {
      "ui:order": [
        "name",
        "description"
      ]
    },
    "time_range": {
      "ui:order": [
        "since",
        "until",
        "timezone",
        "time_format"
      ]
    },
    "ui:order": [
      "workflow_details",
      "time_range",
      "er_client_name",
      "Subject Group",
      "Previous Period",
      "generate_word_report"
    ]
  },
  "additionalProperties": false
}
