    "er_client_name": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "$ref": "#/$defs/EarthRangerConnection",
          "title": "",
          "description": "Select one of your configured data sources."
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "Connect to EarthRanger"
    },
    "get_events_data": {
      "additionalProperties": false,
      "properties": {
        "event_types": {
          "items": {
            "type": "string"
          },
          "title": "Event Types",
          "type": "array",
          "description": "Specify the event type(s) to analyze (optional). Leave this section empty to analyze all event types."
        }
      },
      "required": [
        "event_types"
      ],
      "type": "object",
      "title": "Retrieve Events"
    },
    "Subject Group": {
      "type": "object",
      "description": "Choose subject group to generate collar voltage charts and overall speedmap",
      "ecoscope:task_group": true,
      "properties": {
        "subject_group_var": {
          "additionalProperties": false,
          "properties": {
            "var": {
              "title": "Subject Group Name",
              "type": "string",
              "default": "Elephants"
            }
          },
          "required": [
            "var"
          ],
          "type": "object",
          "title": ""
        }
      }
    },
    "Previous Period": {
      "type": "object",
      "description": "Define the comparison (\"previous\") period to contrast against your selected time range. Every option below computes a period that ends on the same End Date as your time range, then works backward to determine its Start Date. Choose Custom to enter your own Years / Months / Weeks / Days offset (defaults to 1 month back), Preset for a common lookback (e.g. 1, 3 or 6 months, or 1 year back), or Calendar to pick an exact Start Date.",
      "ecoscope:task_group": true,
      "properties": {
        "set_previous_period": {
          "additionalProperties": false,
          "properties": {
            "offset": {
              "anyOf": [
                {
                  "$ref": "#/$defs/PresetPreviousPeriod"
                },
                {
                  "$ref": "#/$defs/CustomPreviousPeriod"
                },
                {
                  "$ref": "#/$defs/CalendarPreviousPeriod"
                }
              ],
              "title": "Offset",
              "description": "Choose how to calculate the comparison period's Start Date. In every mode, the comparison period ends on your selected time range's Start Date (so it never overlaps with the current period) \u2014 only the Start Date changes."
            }
          },
          "required": [
            "offset"
          ],
          "type": "object",
          "title": ""
        }
      }
    },
    "vehicle_patrols": {
      "additionalProperties": false,
      "properties": {
        "patrol_types": {
          "items": {
            "type": "string"
          },
          "title": "Patrol Types",
          "type": "array",
          "description": "Specify the patrol type(s) to analyze (optional). Leave empty to analyze all patrol types."
        },
        "status": {
          "default": [
            "done"
          ],
          "items": {
            "enum": [
              "active",
              "overdue",
              "done",
              "cancelled"
            ],
            "type": "string"
          },
          "title": "Patrol Status",
          "type": "array",
          "description": "Choose to analyze patrols with a certain status. If left empty, patrols of all status will be analyzed",
          "uniqueItems": true,
          "ecoscope:advanced": true
        }
      },
      "required": [
        "patrol_types"
      ],
      "type": "object",
      "title": "Retrieve vehicle patrols"
    },
    "foot_patrols": {
      "additionalProperties": false,
      "properties": {
        "patrol_types": {
          "items": {
            "type": "string"
          },
          "title": "Patrol Types",
          "type": "array",
          "description": "Specify the patrol type(s) to analyze (optional). Leave empty to analyze all patrol types."
        },
        "status": {
          "default": [
            "done"
          ],
          "items": {
            "enum": [
              "active",
              "overdue",
              "done",
              "cancelled"
            ],
            "type": "string"
          },
          "title": "Patrol Status",
          "type": "array",
          "description": "Choose to analyze patrols with a certain status. If left empty, patrols of all status will be analyzed",
          "uniqueItems": true,
          "ecoscope:advanced": true
        }
      },
      "required": [
        "patrol_types"
      ],
      "type": "object",
      "title": "Retrieve foot patrols"
    }
  },
  "$defs": {
    "TimezoneInfo": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tzCode": {
          "title": "Tzcode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "utc": {
