{
  "properties": {
    "workflow_details": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Workflow Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Workflow Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "description": "Add information that will help to differentiate this workflow from another.",
      "title": "Set workflow details"
    },
    "time_range": {
      "additionalProperties": false,
      "properties": {
        "since": {
          "format": "date-time",
          "title": "Since",
          "type": "string",
          "description": "The start time"
        },
        "until": {
          "format": "date-time",
          "title": "Until",
          "type": "string",
          "description": "The end time"
        },
        "timezone": {
          "allOf": [
            {
              "$ref": "#/$defs/TimezoneInfo"
            }
          ],
          "default": null,
          "title": "Timezone"
        },
        "time_format": {
          "default": "%d %b %Y %H:%M:%S",
          "title": "Time Format",
          "type": "string",
          "description": "The time format",
          "ecoscope:advanced": true
        }
      },
      "required": [
        "since",
        "until"
      ],
      "type": "object",
      "description": "Choose the period of time to analyze.",
      "title": "Define analysis time range"
    },
    "er_client_name": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "$ref": "#/$defs/EarthRangerConnection",
          "title": "",
          "description": "Select one of your configured data sources."
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "Connect to earth ranger"
    },
    "subject_group_var": {
      "additionalProperties": false,
      "properties": {
        "var": {
          "title": "",
          "type": "string"
        }
      },
      "required": [
        "var"
      ],
      "type": "object",
      "title": ""
    },
    "set_previous_period": {
      "additionalProperties": false,
      "properties": {
        "offset": {
          "anyOf": [
            {
              "$ref": "#/$defs/PresetPreviousPeriod"
            },
            {
              "$ref": "#/$defs/CustomPreviousPeriod"
            },
            {
              "$ref": "#/$defs/CalendarPreviousPeriod"
            }
          ],
          "title": "Offset",
          "description": "How to compute the start of the comparison period."
        }
      },
      "required": [
        "offset"
      ],
      "type": "object",
      "title": ""
    },
    "generate_word_report": {
      "additionalProperties": false,
      "properties": {
        "org_logo_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Org Logo Path"
        }
      },
      "required": [
        "org_logo_path"
      ],
      "type": "object",
      "title": "Generate Collar Voltage Word Report"
    }
  },
  "$defs": {
    "TimezoneInfo": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tzCode": {
          "title": "Tzcode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "utc": {
          "title": "Utc",
          "type": "string"
        }
      },
      "required": [
        "label",
        "tzCode",
        "name",
        "utc"
      ],
      "title": "TimezoneInfo",
      "type": "object"
    },
    "EarthRangerConnection": {
      "properties": {
        "name": {
          "title": "Data Source",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "EarthRangerConnection",
      "type": "object"
    },
    "CalendarPreviousPeriod": {
      "properties": {
        "since": {
          "description": "Select the start date for the comparison period.",
          "format": "date-time",
          "title": "Since",
          "type": "string"
        }
      },
      "required": [
        "since"
      ],
      "title": "Calendar",
      "type": "object"
    },
    "CustomPreviousPeriod": {
      "properties": {
        "years": {
          "default": 0,
          "title": "Years",
          "type": "integer"
        },
        "months": {
          "default": 0,
          "title": "Months",
          "type": "integer"
        },
        "weeks": {
          "default": 0,
          "title": "Weeks",
          "type": "integer"
        },
        "days": {
          "default": 0,
          "title": "Days",
          "type": "integer"
        },
        "hours": {
          "default": 0,
          "title": "Hours",
          "type": "integer"
        },
        "minutes": {
          "default": 0,
          "title": "Minutes",
          "type": "integer"
        },
        "seconds": {
          "default": 0,
          "title": "Seconds",
          "type": "integer"
        }
      },
      "title": "Custom",
      "type": "object"
    },
    "PresetPreviousPeriod": {
      "properties": {
        "preset": {
          "default": "1 month back",
          "description": "Choose a predefined time offset.",
          "enum": [
            "Same as current period",
            "1 month back",
            "3 months back",
            "6 months back",
            "1 year back"
          ],
          "title": "Preset",
          "type": "string"
        }
      },
      "title": "Preset",
      "type": "object"
    }
  },
  "uiSchema": {
    "workflow_details": {
      "ui:order": [
        "name",
        "description"
      ]
    },
    "time_range": {
      "ui:order": [
        "since",
        "until",
        "timezone",
        "time_format"
      ]
    },
    "ui:order": [
      "workflow_details",
      "time_range",
      "er_client_name",
      "subject_group_var",
      "set_previous_period",
      "generate_word_report"
    ]
  },
  "additionalProperties": false
}
